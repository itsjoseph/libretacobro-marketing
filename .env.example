# Configuración SMTP para Hostinger Email.
# Copia este archivo como .env y escribe la contraseña del buzón:
#   cp .env.example .env && chmod 600 .env
# El archivo .env NO se sube a git (está en .gitignore).
# No pongas comentarios al final de una línea: se tomarían como parte del valor.

# Buzón creado en hPanel → Correos (usuario = dirección completa)
APP_MAIL_FROM=info@libretadecobro.com
SMTP_USER=info@libretadecobro.com
SMTP_PASSWORD=

# Servidor de salida de Hostinger: 465 con SSL (o 587 con SMTP_SECURITY=starttls)
SPRING_MAIL_HOST=smtp.hostinger.com
SPRING_MAIL_PORT=465
SMTP_SECURITY=ssl

APP_MAIL_FROM_NAME=Libreta de Cobro
MAIL_DELAY_SECONDS=1
MAIL_RECONNECT_EVERY=100
MAIL_MAX_CONSECUTIVE_ERRORS=5
